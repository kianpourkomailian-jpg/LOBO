# ====================================================================
# LOBO AI LEADS — Environment configuration template
# --------------------------------------------------------------------
# Copy this file to ".env" and fill in the real values.
# NEVER commit your real ".env" file or your credential JSON to git.
# ====================================================================

# --- Google service account credentials ----------------------------
# Path INSIDE the running app/container to the service account JSON key.
# On Railway/Render you typically mount the secret to a file and point here.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service_account.json

# ALTERNATIVE for cloud hosts that only allow env vars (no files):
# paste the entire service account JSON as a single-line string here.
# If set, this takes priority over GOOGLE_SERVICE_ACCOUNT_FILE.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Drive folder layout --------------------------------------------
# We do NOT hardcode folder IDs. Instead we look folders up by NAME.
# This is the name of the top-level project folder in Google Drive.
DRIVE_ROOT_FOLDER_NAME=LOBO_AI_LEADS

# Subfolder names (must match what exists in Drive). Defaults shown.
DRIVE_RAW_FOLDER=01_RAW_LINKEDIN_EXPORTS
DRIVE_CLEANED_FOLDER=02_CLEANED_LEADS
DRIVE_PROCESSED_FOLDER=03_PROCESSED_LEADS
DRIVE_CALL_HISTORY_FOLDER=04_CALL_HISTORY
DRIVE_DONOT_CONTACT_FOLDER=05_DONOT_CONTACT

# Inbox for ad-hoc, free-text leads (anything that isn't a LinkedIn export).
# Auto-created on first run if missing. Extraction from these files is not
# yet implemented — items park here until the dump parser is wired in.
DRIVE_DUMP_FOLDER=07_RAW_DUMP

# --- Optional: restrict search to a Shared Drive --------------------
# Leave blank for "My Drive" / normal folders shared with the service account.
DRIVE_SHARED_DRIVE_ID=

# --- Scheduling (used in later stages) ------------------------------
# How often the folder watcher checks for new uploads, in seconds.
WATCH_INTERVAL_SECONDS=60

# --- Logging --------------------------------------------------------
LOG_LEVEL=INFO
